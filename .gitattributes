# Vendored files are hash-locked: never let git rewrite their line endings.
engine/vendor/** -text
# Built templates are generated with LF endings; keep them byte-identical.
template/*.html -text
*.png binary
*.woff2 binary
# Generated guide: keep byte-identical to the build output.
AUTHORING.md -text
# Presentation projects: keep decks byte-exact (update.py and check.py compare them).
presentations/**/*.html -text
