# Vendored files are hash-locked: never let git rewrite their line endings.
engine/vendor/** -text
# Built templates are generated with LF endings; keep them byte-identical.
template/*.html -text
*.png binary
*.jpg binary
*.webp binary
*.woff2 binary
# Generated guide: keep byte-identical to the build output.
AUTHORING.md -text
# Presentation projects and their showcase copies: keep decks byte-exact (update.py and check.py
# compare them; showcase.py copies them unchanged).
presentations/**/*.html -text
showcase/**/*.html -text
# GitHub language statistics: count the engine and tool sources only, not generated files,
# vendored fonts/KaTeX or the example talks (each deck carries the whole engine inline).
template/** linguist-generated
AUTHORING.md linguist-generated
engine/vendor/** linguist-vendored
showcase/** linguist-documentation
tools/tests/fixtures/** linguist-documentation
